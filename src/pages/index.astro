---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import EncodingFigure from '../components/EncodingFigure.astro';
import { projects, work } from '../data/site';

const [bedrock, folios, ehbc] = projects;
---

<Base>
  <section class="wrap hero">
    <h1>Minsu Kwon<span>권민수</span></h1>
    <p>I work on systems from the instruction set up, and build web services for a living.</p>
  </section>

  <section class="wrap grid" id="projects">
    <ProjectCard {...bedrock} big>
      <div class="encoding"><EncodingFigure /></div>
    </ProjectCard>
    <ProjectCard {...folios}>
      <img src="/media/folios-qemu.webp" alt="foliOS running stress tests in QEMU" width="1200" height="452" />
    </ProjectCard>
    <ProjectCard {...ehbc}>
      <video
        src="/media/ehbc-firmware.mp4"
        poster="/media/ehbc-firmware-poster.webp"
        autoplay
        muted
        loop
        playsinline
        aria-label="EHBC firmware enumerating devices"></video>
    </ProjectCard>
  </section>

  <section class="wrap other" id="other">
    <h2 class="section-title">Other work</h2>
    <ul>
      {work.map((item) => (
        <li>
          <a href={item.href}>{item.name}</a>
          <span>{item.text}</span>
        </li>
      ))}
    </ul>
    <p class="more"><a href="/about/#experience">Experience</a> · <a href="/about/#awards">Awards</a></p>
  </section>
</Base>

<style>
  .hero {
    margin-top: 88px;
  }
  h1 {
    font-size: clamp(34px, 6vw, 48px);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  h1 span {
    font-size: 0.42em;
    font-weight: 400;
    color: var(--mute);
    margin-left: 10px;
    letter-spacing: 0;
  }
  .hero p {
    margin-top: 12px;
    font-size: clamp(16px, 2.2vw, 19px);
    color: var(--mute);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 18px;
    margin-top: 56px;
  }
  .encoding {
    width: 100%;
    padding: 32px 28px;
  }
  img,
  video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
    display: block;
  }
  .other {
    margin-top: 72px;
  }
  .other ul {
    list-style: none;
    padding: 0;
  }
  .other li {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 16px;
    padding: 10px 0;
    border-top: 1px solid var(--line);
    font-size: 15px;
  }
  .other li a {
    font-weight: 600;
    text-decoration: none;
  }
  .other li a:hover {
    text-decoration: underline;
  }
  .other li span {
    color: var(--mute);
  }
  .more {
    margin-top: 24px;
    font-size: 14px;
    color: var(--mute);
  }
  @media (max-width: 760px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .other li {
      grid-template-columns: minmax(0, 1fr);
      gap: 2px;
    }
  }
</style>
